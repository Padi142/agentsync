{
  "name": "@agentsync/template",
  "version": "0.1.0",
  "description": "The AgentSync Template grammar: parse, validate, and Render Templates",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
