{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agentsync",
  "account_id": "96e93dbd051ab80c048e781ecf028a7a",
  "workers_dev": true,
  "main": "src/server.ts",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agentsync-db",
      "database_id": "641eb5f9-8545-4c7c-8fda-e44992ce06f3",
      // Local dev keeps its own D1, stored under this ID in .wrangler/state.
      "preview_database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle/migrations",
      "migrations_pattern": "drizzle/migrations/*.sql"
    }
  ],
  // Space file contents (docs/adr/0004-…). Create once with `wrangler r2 bucket create agentsync-spaces`.
  "r2_buckets": [{ "binding": "SPACES_BUCKET", "bucket_name": "agentsync-spaces" }],
  // One SpaceHub per Space fans live updates out to viewers over hibernating WebSockets.
  "durable_objects": { "bindings": [{ "name": "SPACE_HUB", "class_name": "SpaceHub" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SpaceHub"] }],
  "vars": {
    "DATABUDDY_WEBSITE_ID": "ddcf6feb-4cb3-40be-944a-47262adf4b69",
    "WORKOS_CLIENT_ID": "client_01M5QJY15Y3SCCP3JDE4EZ39YP",
    "WORKOS_REDIRECT_URI": "https://agentsync.krejzac.cz/callback"
  },
  // The Skills update check and the purge of expired Spaces (src/server.ts).
  "triggers": { "crons": ["*/10 * * * *"] },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true
    }
  }
}
